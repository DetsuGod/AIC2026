# ==============================================================================
# AIC 2026 - MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Hãy copy file này thành .env và điền các thông tin thực tế của đội thi.
# ==============================================================================

# Khóa Gemini VLM API (Tùy chọn)
GEMINI_API_KEY=your_gemini_api_key_here

# Cấu hình máy chủ chấm điểm DRES (Vòng Chung Kết).
# Backend tự đăng nhập khi khởi động; không đưa password vào frontend/localStorage.
DRES_SERVER_URL=https://eventretrieval.one
DRES_USERNAME=team_xxx
DRES_PASSWORD=your_dres_password_here
